<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_form_view_inherit_pimcore_json_customization" model="ir.ui.view">
        <field name="name">product.normal.form.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <button name="action_open_label_layout" position="after">
                <button name="clear_printing_json_data" string="Clear Json Printing Data" type="object" class="btn-primary"/>
                <button name="clear_shipping_json_data" string="Clear Json Shipping Data" type="object" class="btn-primary"/>
            </button>
            <xpath expr="//notebook" position="inside">
                <page string="Json Printing Details">
                        <!-- Printing Locations -->
                    <group>
                        <field name="printing_location_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="method_ids" widget="many2many_tags"/>
                            </list>
                        </field>
                    </group>

                    <!-- Printing Methods -->
                    <group>
                        <field name="printing_method_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="location_id"/>
                                <field name="name"/>
                                <field name="color_ids" widget="many2many_tags" optional="show"/>
                                <field name="size_ids" widget="many2many_tags" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <!-- Printing Colors & Sizes -->
                    <group>
                        <field name="printing_color_and_size_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="printing_type"/>
                                <field name="location_id"/>
                                <field name="color_method_id" optional="show"/>
                                <field name="size_method_id" optional="hide"/>
                                <field name="color_name" optional="show"/>
                                <field name="size_name" optional="hide"/>
                                <field name="setup_charge" optional="hide"/>
                                <field name="repeat_charge" optional="hide"/>
                                <field name="extra_charge" optional="hide"/>
                                <field name="vendor_currency_id"/>
                                <field name="qty_price_ids" widget="many2many_tags" optional="show"/>
                            </list>
                        </field>
                    </group>
                     <!-- Shipping Templates -->
                    <group name="Shipping Products">
                        <field name="shipping_product_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="qty_price_ids" widget="many2many_tags" optional="show"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
