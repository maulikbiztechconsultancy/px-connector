<odoo>
	<data>
		<record id="inherit_website_sale_product_variant_form_view" model="ir.ui.view">
	        <field name="name">inherit.form.printerp.product.variant</field>
	        <field name="model">product.product</field>
	        <field name="inherit_id" ref="product.product_normal_form_view"/>
	        <field name="arch" type="xml">
                 <xpath expr="//page[@name='inventory']" position="after">
                 	<page name="pimcore_json_data_variant" string="Pimcore Json">
                 		<field name="json_data_varaint" string="Json Data"/>
                 	</page>
                 	<page name="pimcore_location_stock" string="Stock Locations">
                 		<field name="stock_location_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="location" required="1"/>
                                <field name="quantity"/>
                            </list>
                 		</field>
                 	</page>
                 </xpath>
	        </field>
        </record>
	</data>
</odoo>