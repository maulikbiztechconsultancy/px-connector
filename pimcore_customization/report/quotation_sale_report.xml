<odoo>
    <data>
        <template id="report_quote_present_custom">
            <style>
            @page {
              margin: 0;
              padding: 0;
              size: A4; /* or Letter, etc. */
            }
            body{
            margin: 0;
            padding: 0;
            box-sizing:border-box;
            }

            .page {
              width: 100%;
              height: 100%;
            }
            </style>
            <t t-call="web.basic_layout">
                <div class="page" style="background-color:#f1f2f2 ;">
                    <table width="100%" height="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:1000px;margin: 0 auto; border-collapse: collapse;table-layout: fixed;page-break-after: always;" class="table table-borderless">
                        <tr>
                            <td rowspan="2" style="width: 45%;padding: 0;padding-left:60px;">
                                <div style="overflow:hidden;position:relative;width: 100%;height: 100%;">
                                    <img t-if="doc.company_id.quote_first_image" t-att-src="image_data_uri(doc.company_id.quote_first_image)" style="max-width:100%;position: absolute;top: 0;left:0;bottom:0;right:0;width: auto;height: 1000px;"/>
                                </div>
                            </td>
                            <td style="width: 55%;background-color: #58595b;padding:60px 20px 20px 100px;">
                                <h1 style="color: #fff;margin-bottom: 10px;font-size: 52px; font-family: 'Inter', sans-serif;font-weight: 700; text-transform: uppercase;">quotation # <t t-esc="doc.name"/></h1>
                                <p style="color: #a7a9ac;font-size: 22px;font-weight: 700; text-transform: uppercase;">prepared for</p>
                                <h2 style="color: #fff;font-size: 48px;margin-top: 20px; margin-bottom: 10px; font-family: 'Inter', sans-serif;font-weight: 700;"><t t-if="doc.partner_id.parent_id"><t t-esc="doc.partner_id.parent_id.name"/></t></h2>
                                <h2 style="color: #fff;font-size: 48px;margin:10px 0px; font-family: 'Inter', sans-serif;font-weight: 700;"><t t-esc="doc.partner_id.name"/></h2>
                                <p style="color: #a7a9ac;font-size: 22px;font-weight: 700;margin: 30px 0 10px; text-transform: uppercase;">Date: <t t-if="doc.date_order"><t t-esc="doc.date_order"/></t></p>
                                <p style="color: #a7a9ac;font-size: 22px;font-weight: 700; text-transform: uppercase;">required date: <t t-if="doc.validity_date"><t t-esc="doc.validity_date"/></t></p>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 55%;background-color: #414042;padding: 55px 20px 20px 55px;">
                                <p style="color: #959699;font-size: 28px;font-weight:300;margin-bottom: 12px; text-transform: uppercase;">account handler: <t t-if="doc.user_id"><t t-esc="doc.user_id.name"/></t></p>
                                <p style="color: #959699;font-size: 28px;font-weight:300;margin-bottom: 12px; text-transform: uppercase;">Email address: <t t-if="doc.partner_id.email"><t t-esc="doc.partner_id.email"/></t></p>
                                <p style="color: #959699;font-size: 28px;font-weight:300;margin-bottom: 12px; text-transform: uppercase;">telephone number: <t t-if="doc.partner_id.phone"><t t-esc="doc.partner_id.phone"/></t></p>
                                <div style="text-align: right;margin-top: 60px;">
                                    <img t-attf-src="/pimcore_customization/static/src/img/white-logo.png" alt="Premier" title="Premier" style="height: 80px;width: auto;max-width: 100%;vertical-align: top;" />
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="page" style="background-color: #f1f2f2;position:relative;z-index:2;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f1f2f2;max-width:1000px;margin: 0 auto; border-collapse: collapse;table-layout: fixed;page-break-after: always;" class="table table-borderless">
                        <tr>
                            <td style="padding: 0;">
                                <table style="background-color: #f1f2f2;width: 100%;border:0;table-layout: fixed;border-collapse: collapse;margin:0;" cellpadding="0" cellspacing="0" border="0" class="table table-borderless">
                                    <tr>
                                        <td style="padding: 20px;width: 185px;vertical-align: middle;">
                                            <img t-attf-src="/pimcore_customization/static/src/img/grey-logo.png"  alt="Premier" title="Premier" style="height: 50px;width: auto;max-width: 100%;vertical-align: top;margin: 0;"/>
                                        </td>
                                        <td align="center" style="vertical-align: middle;width: 610px;">
                                            <img t-attf-src="/pimcore_customization/static/src/img/trustpilot.png" alt="trustpilot" title="trustpilot" style="height:50px;max-width:100%"/>
                                        </td>
                                        <td style="background-color: #e3f8c9;padding: 10px;width: 205px;text-align: center;">
                                            <p style="color: #055b79;font-size: 14px;font-weight: 900;margin:0px;">Offset the impact of your order using Gold Standard Certified carbon sequestering</p>
                                            <button style="color: #fff;border-radius: 30px;padding: 3px 15px;margin: 5px 0;background-color:#12305a;font-size: 10px;font-weight:900;text-transform:uppercase;border:0;outline: 0;display:inline-block;width: 180px;">learn about offsetting</button>
                                            <h3 style="color:#00585c;font-size:14px;font-weight:700;margin: 0;">Optional Extra</h3>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0;padding-left: 20px;">
                                <table style="margin: 0;background-color: #fff;width: 100%;border-collapse: collapse;border:0;table-layout: fixed;" cellpadding="0" cellspacing="0" border="0" class="table table-borderless">
                                    <t t-foreach="doc.get_report_quotation_data()" t-as="data">
                                        <tr>
                                            <td style="width: 80px;vertical-align: top;padding: 10px 5px;">
                                                <img t-if="data['product_image']" alt="Premier" title="Premier" style="height: 80px;width: auto;max-width: 100%;vertical-align: top;" t-att-src="image_data_uri(data['product_image'])" />
                                            </td>
                                            <td style="width:350px;">
                                                <table cellpadding="0" cellspacing="0" border="0" style="table-layout: fixed;border-collapse: collapse;margin: 0;" class="table table-borderless">
                                                    <tr>
                                                        <td colspan="2" style="padding:20px 10px 30px;">
                                                            <h2 style="font-size: 20px;color: #414046;font-weight:900;"><t t-esc="data['product_name']"/></h2>
                                                            <p style="font-size: 14px;margin: 7px 0;">Print Specifiation / branding</p>
                                                            <span style="color: #a2a19d;font-weight: 300;font-size: 14px;line-height: 17px;"><t t-esc="data['product_description']"/></span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size: 14px;padding: 0 10px 10px;">
                                                            Lead time: <t t-esc="data['lead_time']"/>
                                                        </td>
                                                        <td style="font-size: 14px;padding: 0 10px 10px; line-height:14px;">Product Code <t t-esc="data['product_code']"/></td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="vertical-align: top;width: 350px;padding: 20px 0 0;">
                                               <table style="width: 100%;border-collapse: collapse;border: 0;table-layout: fixed;margin: 0;" cellpadding="0" cellspacing="0" border="0" class="table table-borderless">
                                                    <thead style="border: 0;">
                                                        <tr>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:50px;text-align:left;">QTY</th>
                                                            <!-- <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:45px;text-align:left;">Setup</th>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:50px;text-align:left;">Delivery</th> -->
                                                            <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:45px;text-align:left;">Each</th>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:80px;text-align:left;">Total to pay</th>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px;font-weight: 900;width:70px;text-align:left;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:40px;"><t t-esc="data['product_uom_qty']"/></td>
                                                            <!-- <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #babbbd;font-size: 12px;width:55px;">
                                                                <t t-if="data['setup_charge']"><t t-esc="data['setup_charge']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></t><t t-else=""> - </t>
                                                            </td> -->
                                                            <!-- <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:60px;">
                                                                <t t-if="data['delivery_charge']">
                                                                <t t-esc="data['delivery_charge']"  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                                </t>
                                                                <t t-else=""> - </t>
                                                                </td> -->
                                                            <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:50px;"><t t-esc="data['price_unit']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                            <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:80px;"><t t-esc="data['price_subtotal']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                            <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #ff0006;font-weight: 700;font-size: 12px;width:50px;"></td>
                                                        </tr>
                                                        <t t-if="float(data['offer_1']) and float(data['offer_price_1'])">
                                                            <tr>
                                                                <!-- <t t-set="amount_offer" t-value="0"/> -->
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:40px;"><t t-esc="data['offer_1']"/></td>
                                                                <!-- <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #babbbd;font-size: 12px;width:55px;"> - </td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #babbbd;font-size: 12px;width:60px;"> - </td> -->
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:50px;"><t t-esc="float(data['offer_price_1'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:80px;"><t t-esc="float(data['offer_amount_1'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #ff0006;font-weight: 700;font-size: 12px;width:50px;">Save <t t-esc="float(data['actual_amount_offer_1'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                            </tr>
                                                        </t>
                                                        <t t-if="data['offer_2'] and data['offer_price_2']">
                                                            <tr>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:40px;"><t t-esc="data['offer_2']"/></td>
                                                                <!-- <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #babbbd;font-size: 12px;width:55px;"> - </td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #babbbd;font-size: 12px;width:60px;"> - </td> -->
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:50px;"><t t-esc="data['offer_price_2']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; font-size: 12px;width:80px;"><t t-esc="data['offer_amount_2']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                                <td style="padding: 5px;border-bottom: 1px solid #a9abad; color: #ff0006;font-weight: 700;font-size: 12px;width:50px;">Save <t t-esc="data['actual_amount_offer_2']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </td>
                                            <td style="width: 205px;vertical-align: top;background-color: #eaffcf;border-left: 1px solid #989a9c;text-align: left;padding: 20px 0 0;">
                                                <table style="width: 100%;border-collapse: collapse;border: 0;table-layout: fixed;marin:0;" cellpadding="0" cellspacing="0" border="0" class="table table-borderless">
                                                    <thead style="border: 0;">
                                                        <tr>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px 10px;font-weight: 900;width:55px;text-align:left;">CO2e</th>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px 10px;font-weight: 900;width:55px;text-align:left;">Total</th>
                                                            <th style="color: #414042; font-size: 12px;padding: 5px 10px;font-weight: 900;width:94.5px;text-align:left;">Offset&amp;nbsp;Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_co2']"><t t-esc="data['carbon_co2']"/>g</t><t t-else=""> - </t></td>
                                                            <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_total']"><t t-esc="data['carbon_total']" />g</t><t t-else=""> - </t></td>
                                                            <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:94.5px;"><t t-if="data['offset_total']"><t t-esc="data['offset_total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></t><t t-else=""> - </t></td>
                                                        </tr>
                                                        <t t-if="data['offer_1'] and data['offer_price_1']">
                                                            <tr>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_co2']"><t t-esc="data['carbon_co2']"/>g</t><t t-else=""> - </t></td>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_total']"><t t-esc="data['carbon_total']" />g</t><t t-else=""> - </t></td>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:94.5px;"><t t-if="data['offset_total']"><t t-esc="data['offset_total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></t><t t-else=""> - </t></td>
                                                            </tr>
                                                        </t>
                                                        <t t-if="data['offer_2'] and data['offer_price_2']">
                                                            <tr>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_co2']"><t t-esc="data['carbon_co2']"/>g</t><t t-else=""> - </t></td>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:55px;"><t t-if="data['carbon_total']"><t t-esc="data['carbon_total']" />g</t><t t-else=""> - </t></td>
                                                                <td style="font-size: 12px;border-bottom: 1px solid #a9abad;padding: 5px 10px;font-weight: 300;color: #8b917d;width:94.5px;"><t t-if="data['offset_total']"><t t-esc="data['offset_total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></t><t t-else=""> - </t></td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" style="background-color: #f1f2f2;height: 4px;"></td>
                                            <td style="background-color: #e3f8c9;height: 4px;border-left: 1px solid #96979a;"></td>
                                        </tr>
                                    </t>
                                    <tr>
                                      <td colspan="3" style="background-color: #f1f2f2;color: #b1b0ac; padding: 15px 7px 20px;font-size: 14px;text-align: center;font-weight: 300;"><t t-esc="doc.note"/></td>
                                        <td style="background-color: #e3f8c9;border-left: 1px solid #96979a;"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
            </div>
            </t>
        </template>
        <report
            id="action_report_quote_presentation"
            model="sale.order"
            string="Quote Presentation"
            report_type="qweb-pdf"
            name="pimcore_customization.report_quote_presentation"
            file="pimcore_customization.report_quote_presentation"
        />
        <template id="report_quote_presentation">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pimcore_customization.report_quote_present_custom" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>
        <record id="paperformat_euro_light" model="report.paperformat">
            <field name="name">A4 (No Margin)</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">0</field>
            <field name="css_margins" eval="True"/>
        </record>

        <record id="action_report_quote_presentation" model="ir.actions.report">
            <field name="name">Quote Presentation</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pimcore_customization.report_quote_presentation</field>
            <field name="report_file">pimcore_customization.report_quote_presentation</field>
            <field name="attachment"/>
            <field name="binding_model_id" ref="pimcore_customization.model_sale_order"/>
            <field name="paperformat_id" ref="pimcore_customization.paperformat_euro_light"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>