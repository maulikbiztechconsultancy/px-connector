<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="mrp_work_center_selection_wizard" model="ir.ui.view">
            <field name="name">mrp.workorder.wizard.custom.wizard</field>
            <field name="model">mrp.workorder.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Workcenter">
                    <sheet>
                        <group>
                            <group>
                                <field name="workcenter_id"/>
                            </group>
                            <group>
                                <field name="resource_id" domain="[('share', '=', False)]"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button class="btn btn-default oe_highlight"  string="Change" type="object" name="action_update_workcenter"/>
                        <button class="btn btn-default oe_inline" special="cancel" string="Cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>