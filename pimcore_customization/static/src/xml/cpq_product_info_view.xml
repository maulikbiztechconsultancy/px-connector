<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
   <t t-name="pimcore_customization.DynamicReportSalesEstimation">
      <Layout display="{ controlPanel: { 'bottom-right': false } }">
         <t t-set-slot="layout-actions">
            <button id="select_products" class="btn btn-primary select_products" t-on-click="ClickSelectProducts">Select Products</button>
            <button id="create_quotation" class="btn btn-primary create_quotation mx-1" t-on-click="ClickCreateQuotation">Create Quotation</button>
            <button id="clear_products" class="btn btn-primary clear_products" t-on-click="ClickClearProducts">Clear Products</button>
            <label class="font-weight-bold d-flex">Currencies:
               <select name="currenlists" id="currenlists" class="o_select form-select border-0 o_dropdown_button" t-on-change="onSelectCurrenlist">
                  <t t-foreach="currenlists" t-as="currency_id" t-key="currency_id.id">
                     <option t-out="currency_id.name" t-att-value="currency_id.id" t-att-selected="currency_id.id == selectedCurrelist.id"/>
                  </t>
               </select>
            </label>
         </t>
      </Layout>
      <t t-out="html"/>
   </t>
</templates>