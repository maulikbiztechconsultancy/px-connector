<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pimcore_customization.productMatrixDialogInherit" t-inherit="product_matrix.dialog">
        <xpath expr="//t[@t-set-slot='footer']/button[1]" position="replace">
            <t t-if="show_cpq and this.props.editedCellAttributes === ''">
                <button class="btn btn-primary" t-on-click="_onConfirmCustom">Next</button>
            </t>
            <t t-else="">
                <button class="btn btn-primary" t-on-click="_onConfirm">Confirm</button>
            </t>
        </xpath>
    </t>
</templates>