<?xml version="1.0" encoding="UTF-8"?>
<template xml:space="preserve" id="template">
    <!-- Printing Image Widget Template -->
    <t t-name="pritxpand_community.PrintingImageWidget">
        <t t-if="props.record.data">
            <t t-set="thumbnailName" t-value="props.record.data.printing_thumbnail_name" />
            <a t-if="props.record.data.printing_thumbnail" t-on-click="showPopup" t-att-class="'fa fa-cloud cursor-pointer'">
            </a>
        </t>
        <t t-else="">
            <p>No product data available.</p>
        </t>
    </t>

    <!-- Custom Popup Template -->
    <t t-name="pritxpand_community.CustomPopup">
        <div class="p-2">
            <t t-if="props.thumbnailName">
                <p><strong>Thumbnail Name:</strong> <t t-esc="props.thumbnailName" /></p>
            </t>
            <t t-else="">
                <p>No thumbnail name available.</p>
            </t>

            <t t-if="props.record.data.printing_thumbnail">
                <p><strong>Thumbnail Image:</strong></p>
                <div class="row">
                    <t t-foreach="props.attachmentImages" t-as="image" t-key="image.id">
                        <div class="col-4 mb-3">
                            <img t-att-src="image.url"
                                 t-att-alt="image.name or 'Attachment Image'"
                                 class="img-fluid"
                                 style="max-width: 200px; max-height: 200px;" />
                            <a t-att-href="image.url"
                                t-att-download="image.name"
                                class="fa fa-download mt-2"
                                style="font-size: 24px; margin-top: 8px; display: block; text-align: center;"
                                title="Download Image"></a>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <p>No thumbnail image available.</p>
            </t>
        </div>
    </t>
</template>