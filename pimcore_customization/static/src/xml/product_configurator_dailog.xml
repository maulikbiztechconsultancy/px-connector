<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pimcore_customization.saleDailogInherit" t-inherit="sale.ProductConfiguratorDialog"  t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='footer']/button[1]" position="replace">
            <t t-if="show_cpq and !this.props.edit">
                <button
                    class="btn btn-primary"
                    t-on-click="_onNextConfigureProduct"
                    t-att-disabled="!isPossibleConfiguration()">
                    Next
                </button>
            </t>
            <t t-else="">
                <button
                    class="btn btn-primary"
                    t-on-click="onConfirm"
                    t-att-disabled="!isPossibleConfiguration()">
                    Confirm
                </button>
            </t>
        </xpath>
    </t>
</templates>