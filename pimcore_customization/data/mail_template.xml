<?xml version="1.0" encoding="utf-8"?>
    <odoo>
        <data noupdate="0">
            <record id="email_template_confirmation_artwork_files" model="mail.template">
                <field name="name">PrintXpand Artwork Confirmation</field>
                <field name="email_from">${{(object.company_id and object.company_id.email or '')}}</field>
                <field name="subject">Approve your design file</field>
                <field name="email_to">${{object.partner_id.email}}</field>
                <field name="model_id" ref="pimcore_customization.model_sale_order"/>
                <field name="body_html" type="html">
                        <p>
                            <t t-set="object_id" t-value="object.id"/>
                            Hello <t t-out="object.partner_id.name"/>,<br/><br/>
                            We have prepared the artwork files for your ordered products based on your requirements.
                            Please check on this link and provide your approval:<a t-att-href="'' + object.artwork_page_url"><t t-out="object.name"/></a> <br/><br/>
                        </p>
                </field>
            </record>

            <record id="email_template_confirmation_artwork_files_to_salesperson" model="mail.template">
            <field name="name">PrintXpand Artwork Email</field>
            <field name="email_from">{{(object.company_id and object.company_id.email or '')}}</field>
            <field name="subject">Approve your design file</field>
            <field name="email_to">{{object.user_id.partner_id.email}}</field>
            <field name="model_id" ref="pimcore_customization.model_sale_order"/>
            <field name="body_html" type="html">
                <div>
                    Hello <t t-out="object.partner_id.name"/>,<br/><br/>
                    Artwork process for the order <t t-out="object.name"/> has been updated by <t t-out="object.partner_id.name"/>
                    <table style="border: 1px solid black; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid black; padding: 8px; text-align: left; width:30%;">Products</th>
                                <th style="border: 1px solid black; padding: 8px; text-align: left; width:30%;">Status</th>
                                <th style="border: 1px solid black; padding: 8px; text-align: left; width:30%;">Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.data_simplify_mail_template()" t-as="parent_group">
                                <t t-set="sale_order_lines" t-value="env['sale.order.line'].search([('parent_line_id','=',parent_group['parent_line_id']),('order_id','=',parent_group['order_id'])])"/>
                                <t t-foreach="sale_order_lines" t-as="line">
                                    <t t-if="line.display_type != 'line_section' and line.show_cpq">
                                        <tr>
                                            <t t-if="line.product_template_id.product_service_type == 'printing'">
                                                <td style="border: 1px solid black;"><t t-esc="line.product_id.display_name"/></td>
                                                <td style="border: 1px solid black;">
                                                    <t t-if="line.product_approval_status == 'accept'">
                                                        <span>Accept</span>
                                                    </t>
                                                    <t t-if="line.product_approval_status == 'accept_with_change'">
                                                        <span>Accept with change</span>
                                                    </t>
                                                    <t t-if="line.product_approval_status == 'reject'">
                                                        <span>Reject</span>
                                                    </t>
                                                    <t t-if="not line.product_approval_status">
                                                        <span>Accept</span>
                                                    </t>
                                                </td>
                                                <td style="border: 1px solid black;"><t t-esc="line.artwork_comment"/></td>
                                            </t>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <t t-if="line.show_cpq">
                                                <th style="text-align: left;" colspan="2"><t t-esc="line.name"/></th>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>

            <record id="email_template_sale_order_approved" model="mail.template">
                <field name="name">Sales: Order Approved</field>
                <field name="model_id" ref="pimcore_customization.model_sale_order"/>
                <field name="subject">Order Approved</field>
                <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
                <field name="email_to">${{object.partner_id.email}}</field>
                <field name="partner_to">{{ object.partner_id.id }}</field>
                <field name="description">Sent to customers on order approved</field>
                <field name="body_html" type="html">
                        <p>
                            <t t-set="object_id" t-value="object.id"/>
                            Hello <t t-out="object.partner_id.name"/>,<br/><br/>
                            Your order <t t-out="object.name"/> has been approved.<br/><br/>
                            Thank you for your trust!<br/><br/>

                            Do not hesitate to contact us if you have any questions.<br/><br/>

                           <br/>
                        </p>
                </field>
                <field name="lang">{{ object.partner_id.lang }}</field>
                <field name="auto_delete" eval="True"/>
            </record>
            <record id="email_template_sale_order_confirm" model="mail.template">
                <field name="name">Sales: Order Confirmed</field>
                <field name="model_id" ref="pimcore_customization.model_sale_order"/>
                <field name="subject">Order Confirmed</field>
                <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
                <field name="email_to">${{object.partner_id.email}}</field>
                <field name="partner_to">{{ object.partner_id.id }}</field>
                <field name="description">Sent to customers on order approved</field>
                <field name="body_html" type="html">
                        <p>
                            <t t-set="object_id" t-value="object.id"/>
                            Hello <t t-out="object.partner_id.name"/>,<br/><br/>
                            Your order <t t-out="object.name"/> has been confirmed.<br/><br/>
                            Thank you for your trust!<br/><br/>

                            Do not hesitate to contact us if you have any questions.<br/><br/>

                           <br/>
                        </p>
                </field>
                <field name="lang">{{ object.partner_id.lang }}</field>
                <field name="auto_delete" eval="True"/>
            </record>
        </data>
    </odoo>