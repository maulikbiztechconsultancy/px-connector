<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cpq_create_quotation_form" model="ir.ui.view">
            <field name="name">cpq.create.quotation.form</field>
            <field name="model">cpq.create.quotation</field>
            <field name="arch" type="xml">
                <form string="CPQ Create Quotation">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" widget="res_partner_many2one"/>
                                <field name="company_id" invisible="1"/>
                                <field name="pricelist_id" required="1"/>
                                <field name="currency_id"/>
                                <field name="client_order_ref"/>
                            </group>
                        </group>
                        <field name="product_lines"  widget="section_and_note_one2many" nolabel="1">
                            <list delete="false" create="false" editable="bottom" name="product_lines">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="display_type" column_invisible="True"/>
                                <field name="product_template_id" options="{'no_open': True}" readonly="1" force_save="1"/>
                                <field name="name"/>
                                <field name="product_id" column_invisible="True"/>
                                <field name="product_uom_qty" force_save="1"/>
                                <field name="price_unit" options="{'currency_field': 'currency_id'}"/>
                                <field name="price_total" force_save="1" options="{'currency_field': 'currency_id'}"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button class="btn btn-default oe_highlight" name="action_create_sale_order" string="Create Quotation" type="object"/>
                        <button class="btn btn-default oe_inline" special="cancel" string="Cancel" type="object"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>