<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//group" position="inside">
                    <field name="po2_id" invisible="1"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" name="action_view_purchase_orders" type="object" icon="fa-credit-card" groups="purchase.group_purchase_user" invisible="purchase_order_count == 0  or po2_id == False">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="purchase_order_count"/></span>
                            <span class="o_stat_text">Purchase</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>