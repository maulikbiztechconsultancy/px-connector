<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_cpq_product_info_form" model="ir.ui.view">
            <field name="name">cpq.product.info.form</field>
            <field name="model">cpq.product.info</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="configure,printing,done" statusbar_colors="{'configure': 'gray', 'printing': 'blue', 'done': 'green'}"/>
                    </header>
                    <sheet>
                        <group invisible = "status != 'configure'">
                            <label for="product_template_id"/>
                            <div class="o_row">
                                <field name="product_template_id"/>
                                <field name="product_image" widget="image" class="oe_avatar"/>
                            </div>

                            <field name="product_variant_line" invisible = "status != 'configure'">
                                <list create="false" delete="false" editable="bottom">
                                    <field name="product_variant"/>
                                    <field name="product_qty" />
                                </list>
                            </field>
                        </group>
                        <group string="Printing Products" invisible = "status != 'printing'">
                            <field name="printing_product_ids" domain="[('id', 'in', context.get('related_printing_product_ids', []))]">
                                <list editable="bottom" create="false" edit="true">
                                    <field name="name"/>
                                    <field name="default_code"/>
                                </list>
                            </field>
                        </group>
                        <group string="Delivery Products" invisible = "status != 'done'">
                            <field name="delivery_product_ids" domain="[('id', 'in', context.get('related_delivery_product_ids', []))]" >
                                <list editable="bottom" create="false" edit="true">
                                    <field name="name"/>
                                    <field name="default_code"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button class="btn btn-secondary" name="action_back_cpq" string="Back" type="object" invisible="status == 'configure'"/>
                        <button class="btn btn-primary" name="action_next_cpq" string="Next" type="object" invisible = "status == 'done'"/>
                        <button class="btn btn-primary" name="action_add_cpq" string="Add" type="object" invisible = "status != 'done'"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="cpq_product_section_form" model="ir.ui.view">
            <field name="name">cpq.product.section.form</field>
            <field name="model">cpq.product.info</field>
            <field name="arch" type="xml">
                <form string="CPQ Product Info">
                    <sheet>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <field name="cpq_product_section_line" widget="section_and_note_one2many" mode="list">
                            <list editable="bottom" create="false" delete="false" edit="false">
                                <field name="display_type" column_invisible="True"/>
                                <field name="product_template_id" />
                                <field name="name"/>
                                <field name="product_qty"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="price_unit" widget="monetary" force_save="1" options="{'currency_field': 'currency_id'}"/>
                                <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </list>
                        </field>
                        <group name="note_group_custom" col="6" class="mt-2 mt-md-0">
                            <group colspan="4">
                            </group>
                            <group class="oe_subtotal_footer_custom" name="sale_total_custom">
                                <field name="grand_total" colspan="2" readonly="1" force_save="1" options="{'currency_field': 'currency_id'}"/>                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="cpq_product_section_view_form">
            <field name="name">CPQ Section product</field>
            <field name="res_model">cpq.product.section.line</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="pimcore_customization.cpq_product_section_form"/>
        </record>

    </data>
</odoo>