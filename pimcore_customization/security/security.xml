<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_printer">
            <field name="name">PrintXpand</field>
            <field name="sequence">104</field>
        </record>

        <record id="group_printerp_admin" model="res.groups">
            <field name="name">PrintXpand Admin</field>
            <field name="category_id" ref="pimcore_customization.module_category_printer"/>
        </record>

        <record id="module_category_manufacturing_workorder" model="ir.module.category">
            <field name="name">Work Orders</field>
            <field name="description">Helps you manage your workorder processes and generate reports on those processes.</field>
            <field name="sequence">6</field>
        </record>

        <record id="group_workorder_own_documents_only" model="res.groups">
            <field name="name">User: Own Work Orders Only</field>
            <field name="category_id" ref="pimcore_customization.module_category_manufacturing_workorder"/>
            <field name="comment">The user will only have access to their own work orders in the manufacturing app.</field>
        </record>

        <record id="work_order_internal_user" model="ir.rule">
            <field name="name">See Own Workorder</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('resource_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('pimcore_customization.group_workorder_own_documents_only'))]"/>
        </record>

        <record id="group_workorder_all_access" model="res.groups">
            <field name="name">User: All work order Documents</field>
            <field name="category_id" ref="pimcore_customization.module_category_manufacturing_workorder"/>
            <field name="implied_ids" eval="[(4, ref('pimcore_customization.group_workorder_own_documents_only'))]"/>
            <field name="comment">the user will have access to all records of everyone in the sales application.</field>
        </record>

        <record id="admin_rule_work_order" model="ir.rule">
            <field name="name">See admin Workorder</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pimcore_customization.group_workorder_all_access'))]"/>
        </record>
    </data>
</odoo>