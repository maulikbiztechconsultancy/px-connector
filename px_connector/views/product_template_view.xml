<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="px_connector_product_template_form_view" model="ir.ui.view">
            <field name="name">connector.product.template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="template_code"/>
                </xpath>
                <xpath expr="//field[@name='type']" position="after">
                    <field name="product_service_type"/>
                    <field name="supplier_id" readonly="0"/>
                </xpath>
            </field>
        </record>

        <record id="connector_product_template_tree_view" model="ir.ui.view">
            <field name="name">product.template.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="product_service_type" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>