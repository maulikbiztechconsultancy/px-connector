<odoo>
	<data>
		<record id="omas_payment_method_mapping_view_search" model="ir.ui.view">
			<field name="name">omas.payment.method.mapping.search</field>
			<field name="model">omas.payment.method.mapping</field>
			<field name="arch" type="xml">
				<search string="Payment Method Mappings">
                    <field name='name'/>
                    <field name="remote_id"/>
					<group string="Group By...">
						<filter
							string ="Instance"
							name   ="filter_by_instance_id"
							context="{'group_by':'instance_id'}"
						/>
						<filter
							string ="Need Update"
							name   ='filter_by_need_sync'
							domain ="[]"
							context="{'group_by':'need_sync'}"
						/>
					</group>
				</search>
			</field>
		</record>

		<record id="omas_payment_method_mapping_form" model="ir.ui.view">
			<field name="name">omas.payment.method.mapping.form</field>
			<field name="model">omas.payment.method.mapping</field>
			<field name="type">form</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<group>
							<group>
								<field name="instance_id"/>
								<field name="instance"/>
							</group>
							<group>
								<field name="need_sync"/>
								<field name="operation"/>
							</group>
						</group>
						<group >
							<group>
								<field name="mapping_display_name" string="Display Name"/>
								<field name="name"/>
							</group>
							<group>
								<field name="remote_id"/>
							</group>
							<field name="odoo_payment_method_id" invisible="1"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record id="omas_payment_method_mapping_tree" model="ir.ui.view">
			<field name="name">omas.payment.method.mapping.tree</field>
			<field name="model">omas.payment.method.mapping</field>
			 
			<field name="arch" type="xml">
				<list string="Payment Method Mapping" decoration-danger="need_sync=='yes'">
					<field name="instance_id"/>
					<field name="remote_id"/>
					<field name="odoo_payment_method_id" optional='hide'/>
					<field name="name"/>
					<field name="operation"/>
					<field name="create_date"/>
					<field name="write_date"/>
					<field name="need_sync"/>
				</list>
			</field>
		</record>

		<record id="omas_payment_method_mapping_action" model="ir.actions.act_window">
			<field name="name">Payment Method Mappings</field>
			<field name="res_model">omas.payment.method.mapping</field>
			<field name="view_mode">list,form</field>
			<field name="context">
                {
                    "search_default_filter_by_instance":1,
                    "search_default_filter_by_instance_id":1
                }
			</field>
			<field name="view_id" ref="omas_payment_method_mapping_tree"/>
		</record>
	</data>
</odoo>
