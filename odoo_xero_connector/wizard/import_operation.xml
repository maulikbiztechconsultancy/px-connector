<odoo>
	<data>
		<record id="omas_import_operation_inherit_view_form" model="ir.ui.view">
			<field name="name">omas.import.operation.form</field>
			<field name="model">omas.import.operation</field>
			<field name="inherit_id" ref="odoo_multi_accounting_solution.omas_import_operation_view_form"/>
			<field name="type">form</field>
			<field name="arch" type="xml">
                <xpath expr="//group[@name='filters']" position="inside">
                    <field name="instance" invisible="1" groups="!base.group_no_one"/>
                    <group invisible = "instance != 'xero'">
						<field
							name  ="omas_filter_type"
                            
							widget="radio"
						/>
					</group>
				</xpath>
                <xpath expr="//group[@name='filters']" position="after">
                    <group>
                        <field name="instance" invisible="1" groups="!base.group_no_one"/>
                        <group invisible="instance != 'xero' or omas_filter_type != 'id'">
                            <field name="object_id" required="omas_filter_type == 'id'" />
                        </group>
                        <group invisible="instance != 'xero' or omas_filter_type != 'date_range'" colspan="2">
                            <group>
                                <field name="omas_min_date" required="omas_filter_type == 'date_range'" />
                            </group>
                            <group>
                                <field name="omas_max_date" required="omas_filter_type == 'date_range'" />
                            </group>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//form" position="inside">
                    <field name="instance" invisible="1" groups="!base.group_no_one"/>
                    <p invisible="not instance == 'xero' or omas_filter_type != 'all'">
                        <strong>Note:</strong> Will import objects of 'All' the time period.
                    </p>
                    <p invisible="instance != 'xero' or omas_filter_type != 'id'">
                        <strong>Note:</strong> Will import object of particular 'By IDs' entered.
                    </p>
                    <p invisible="instance != 'xero' or omas_filter_type != 'date_range'">
                        <strong>Note:</strong> Will import object between Minimum and Maximum Create Date Added.
                    </p>
				</xpath>
			</field>
		</record>

		<record id="omas_import_operation_action" model="ir.actions.act_window">
			<field name="name">OMAS Import Wizard</field>
			<field name="res_model">omas.import.operation</field>
			<field name="view_mode">form</field>
			<field name="target">new</field>
		</record>
    </data>
</odoo>
