<odoo>
	<data noupdate='1'>
		<record id="xero_instance" model="omas">
            <field name="name">Xero</field>
            <field name="instance">xero</field>
            <field name="client_id">xxx-xxx-xxx</field>
            <field name="client_secret">xxx-xxx-xxx</field>
            <field name="auto_evaluate_feed">True</field>
            <field name="api_limit">50</field>
            <field name="debug">False</field>
            <field name="image" type="base64" file="odoo_xero_connector/static/description/icon.png"/>
            <field name="order_state_ids" eval="[
						(0,0,{'instance_state':'DRAFT','odoo_order_state':'draft','default_order_state':True}),
                        (0,0,{'instance_state':'SENT','odoo_order_state':'draft'}),
                        (0,0,{'instance_state':'ACCEPTED','odoo_order_state':'sale'}),
                        (0,0,{'instance_state':'INVOICED','odoo_order_state':'sale'}),
                        (0,0,{'instance_state':'DECLINED','odoo_order_state':'cancelled'})
					]" />
        </record>
	</data>
</odoo>
