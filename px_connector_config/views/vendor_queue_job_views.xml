<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="vendor_queue_job_view_form" model="ir.ui.view">
        <field name="name">vendor.queue.job.form</field>
        <field name="model">vendor.queue.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="import_category_job_datas" string="Import Start Category Data" type="object" class="btn-primary"/>
                    <button name="import_product_job_datas" string="Import Start Product Data" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="method_name"/>
                            <field name="category_method_name"/>
                            <field name="pim_config_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Queue" name="job_queue">
                            <field name="queue_job_lines"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_queue_job_view_list" model="ir.ui.view">
        <field name="name">vendor.queue.job.view.list</field>
        <field name="model">vendor.queue.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="view_queue_job_form" model="ir.ui.view">
        <field name="name">queue.job.form</field>
        <field name="model">queue.job</field>
        <field name="arch" type="xml">
            <form string="Jobs" create="false" delete="false">
                <header>
                    <!-- allow to unlock locked orders even if setting is not enabled (e.g. orders synchronized from connectors) -->
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"
                            data-hotkey="x"/>
                    <!-- <button name="action_process" type="object" string="Process" invisible="state == 'cancelled'" data-hotkey="x"/> -->
                    <button name="action_draft" invisible="state != 'cancelled'" type="object" string="Set to Draft"
                            data-hotkey="w"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,process,done"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="model_id"/>
                            <field name="records"/>
                            <field name="dependencies"/>
                            <field name="error_reason"/>
                            <field name="error_reason_text"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="sub_reference"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="priority"/>
                            <field
                                    name="company_id"
                                    groups="base.group_multi_company"
                            />
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="date_created"/>
                        </group>
                    </group>
                    <notebook>
                        <page
                                name="results"
                                string="Results">
                            <group
                                    name="result"
                                    string="Result"
                                    invisible="result == False">
                                <field nolabel="1" name="result"/>
                            </group>
                        </page>
                        <page
                                name="error_reason_text"
                                string="Error Reason" invisible="error_reason_text == False">
                            <group
                                    name="error_reason_text"
                                    string="Error Reason"
                                    invisible="error_reason_text == False">
                                <field nolabel="1" name="error_reason_text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_queue_job_tree" model="ir.ui.view">
        <field name="name">queue.job.tree</field>
        <field name="model">queue.job</field>
        <field name="arch" type="xml">
            <list
                    create="false">
                <field name="name"/>
                <field name="reference"/>

                <field name="date_done"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" decoration-success="state == 'done'" decoration-info="state == 'draft'"
                       decoration-primary="state == 'process'" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_queue_job_search" model="ir.ui.view">
        <field name="name">queue.job.search</field>
        <field name="model">queue.job</field>
        <field name="arch" type="xml">
            <search string="Jobs">
                <field name="name"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="action_queue_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">queue.job</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_name': 1}</field>
        <field name="view_id" ref="view_queue_job_tree"/>
        <field name="search_view_id" ref="view_queue_job_search"/>
    </record>

    <record id="action_vendor_queue_job" model="ir.actions.act_window">
        <field name="name">Vendor Queue Job</field>
        <field name="res_model">vendor.queue.job</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
            id="menu_vendor_queue_job"
            action="action_vendor_queue_job"
            sequence="10"
            parent="menu_pimore_config_root"
    />

    <menuitem
            id="menu_queue_job"
            action="action_queue_job"
            sequence="10"
            parent="menu_pimore_config_root"
    />

</odoo>