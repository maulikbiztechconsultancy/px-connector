<odoo>
    <record id="view_pimore_vendor_config_form" model="ir.ui.view">
        <field name="name">pimore.vender.config.form</field>
        <field name="model">pimore.vender.config</field>
        <field name="arch" type="xml">
            <form string="Supplier Configuration">
                <header>
                    <button name="action_fetch_pimcore_data" string="Fetch Pimcore Category Data" type="object" class="btn-primary"/>
                    <button name="action_fetch_pimcore_product_data" string="Fetch Pimcore Product Data" type="object" class="btn-primary"/>
                    <button name="open_update_category_wizard" string="Open Update Category Wizard" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vendor_short_code" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="currency_id"/>
                            <field name="converted_currency_id"/>
                        </group>
                        <group>
                            <field name="endpoint_url"/>
                            <field name="general_api_key"/>
                            <field name="api_key"/>
                            <field name="printing_product"/>
                            <field name="shipping_product"/>
                            <field name="product_id"/>
                            <field name="setup_charge_product_id"/>
                            <field name="delivery_product_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Categories">
                            <group>
                                <group name="category_query" string="Category Query">
                                    <field name="query_text" nolabel="1"/>
                                </group>
                                <group name="category_field">
                                    <separator string="Category Relation" colspan="4"/>
                                    <field name="category_relation_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="odoo_caegory_id" required="1"/>
                                            <field name="pim_category_id"/>
                                        </list>
                                    </field>
                                    <separator string="Category Details" colspan="4"/>
                                    <field name="category_field_lines" nolabel="1">
                                       <list editable="bottom">
                                            <field name="product_category_field_id" required="1"/>
                                            <field name="custom_value"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="Products">
                            <group>
                                <group name="schedule_next_time" string="Schedule Next Time">
                                    <field name="next_schedule_date"/>
                                    <field name="partner_id" required="1"/>
                                    <field name="create_pricelist" widget="radio"/>
                                    <field name="sale_margin"/>
                                </group>
                                <group name="schedule_next_time" string="Limit">
                                    <field name="get_limit"/>
                                    <field name="total_values"/>
                                    <field name="total_remaining_values"/>
                                </group>
                                <group name="product_query" string="Product Query">
                                    <field name="product_query_text" nolabel="1"/>
                                </group>
                                <group name="product_field" string="Product Data">
                                    <field name="product_field_lines">
                                        <list editable="bottom">
                                            <field name="product_field_id" required="1"/>
                                            <field name="custom_value"/>
                                        </list>
                                    </field>
                                    <field name="image_data"/>
                                </group>
                            </group>
                        </page>
                        <page string="Attributes &amp; Variants">
                            <field name="attribute_line_fields">
                                <list editable="bottom">
                                    <field name="attribute_id" required="1"/>
                                    <field name="custom_link"/>
                                    <button name="set_attibute_values" string="Set Values" type="object" clase="btn-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Printing Product" invisible="printing_product != True">
                             <group>
                                 <group name="product_query" string="Product Query">
                                    <field name="product_query_text" nolabel="1"/>
                                </group>
                                 <group name="printing_product_field">
                                     <separator string="Printing Product Data" colspan="4"/>
                                     <field name="printing_product_name"/>
                                     <field name="price_list_data"/>
                                     <separator string="Printing Product Attribute Values" colspan="4"/>
                                     <field name="printing_product_attribute_lines">
                                         <list editable="bottom">
                                             <field name="attribute_id" required="1"/>
                                             <field name="custom_value"/>
                                             <field name="stop_variant_creation"/>
                                         </list>
                                    </field>
                                 </group>
                             </group>
                        </page>
                        <page string="Update Product">
                             <group name="product_query">
                                <group name="update_details" string="Update Details">
                                    <field name="update_product"/>
                                    <field name="interval_type"/>
                                    <field name="last_synced_date"/>
                                    <!-- <field name="last_synced_date"/> -->
                                </group>
                                <group name="update_query_details" string="Query Details">
                                    <field name="update_query"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pimore_vender_config_list" model="ir.ui.view">
        <field name="name">pimore.vender.config.list</field>
        <field name="model">pimore.vender.config</field>
        <field name="arch" type="xml">
            <list string="Supplier Configuration">
                <field name="name"/>
                <field name="endpoint_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_pimore_vender_config" model="ir.actions.act_window">
        <field name="name">Supplier Configuration</field>
        <field name="res_model">pimore.vender.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Pimcore supplier configuration!
            </p>
        </field>
    </record>

    <menuitem id="menu_pimore_config_root" name="PX Connector" web_icon="px_connector_config,static/description/icon.png"/>
    <menuitem id="menu_pimore_config" name="PX Vendor Configuration"
              parent="menu_pimore_config_root" action="action_pimore_vender_config"/>
</odoo>
