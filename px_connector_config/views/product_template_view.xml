<odoo>
	<data>
		<record id="inherit_website_sale_product_variant_form_view" model="ir.ui.view">
	        <field name="name">inherit.form.printerp.product.variant</field>
	        <field name="model">product.product</field>
	        <field name="inherit_id" ref="product.product_normal_form_view"/>
	        <field name="arch" type="xml">
                 <xpath expr="//page[@name='inventory']" position="after">
                 	<page name="pimcore_json_data_variant" string="Pimcore Json">
                 		<field name="json_data_varaint" string="Json Data"/>
                 	</page>
                 	<page name="pimcore_location_stock" string="Stock Locations">
                 		<field name="stock_location_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="location" required="1"/>
                                <field name="quantity"/>
                            </list>
                 		</field>
                 	</page>
                 </xpath>
				<xpath expr="//div[@name='list_price_uom']" position="after">
					<label for="repeat_charge" string="Repeat Charge"/>
					<div name="repeat_charge_uom">
						<field name="repeat_charge"
							   class="oe_inline"
							   widget="monetary"
							   options="{'currency_field': 'currency_id', 'field_digits': True}"/>
					</div>
					<label for="setup_charge" string="Setup Charge"/>
					<div name="setup_charge_uom">
						<field name="setup_charge"
							   class="oe_inline"
							   widget="monetary"
							   options="{'currency_field': 'currency_id', 'field_digits': True}"/>
					</div>
					<label for="image" string="image"/>
					<div name="image">
						<field name="image"/>
					</div>
					<label for="printing_template_ids" string="Printing Template"/>
                    <div name="printing_template">
                        <field name="printing_template_ids"  widget="many2many_tags"/>
                    </div>
                    <label for="printing_variant_ids" string="Printing Variants"/>
                    <div name="printing_template">
                        <field name="printing_variant_ids"  widget="many2many_tags"/>
                    </div>
					<label for="shipping_variant_ids" string="Shipping Variants"/>
                    <div name="shipping_variant_ids">
                        <field name="shipping_variant_ids"  widget="many2many_tags"/>
                    </div>
				</xpath>
	        </field>
        </record>
	</data>
</odoo>