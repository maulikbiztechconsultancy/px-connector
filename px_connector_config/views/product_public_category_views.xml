<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_website_sale_product_template_form_view" model="ir.ui.view">
            <field name="name">inherit.form.printerp.product.template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="inside">
                    <div>
                        <field name="is_artwork_product"/>
                        <label for="is_artwork_product"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='uom_po_id']" position="after">
                    <field name="magento_rec_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>