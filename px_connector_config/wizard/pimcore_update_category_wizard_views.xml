<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_pimcore_update_category_wizard" model="ir.ui.view">
        <field name="name">view.pimcore.update.category.wizard</field>
        <field name="model">pimcore.update.category.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Category">
                  <group>
                    <group>
                        <field name="product_category" />
                    </group>
                    <group>
                        <field name="product_public_category" />
                    </group>
                  </group>
                <footer>
                    <button name="action_update_category" type="object" string="Apply" class="btn-primary" />
                    <button string="Cancel" class="btn btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
